{
  "name": "tork-garaji",
  "version": "1.0.0",
  "private": true,
  "description": "Lego tarzı araç mühendisliği oyunu (Android)",
  "scripts": {
    "build:web": "node scripts/build-web.js",
    "build:preview": "node scripts/build-web.js --single",
    "test": "node test/solvable.test.js",
    "test:quick": "node test/solvable.test.js --quick",
    "solutions": "node tools/solpack.js",
    "sync": "npm run build:web && npx cap sync android",
    "android:init": "npm run build:web && npx cap add android && node scripts/patch-android.js"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/status-bar": "8.0.3",
    "@fontsource/barlow": "5.3.0",
    "@fontsource/chakra-petch": "5.3.0",
    "planck": "1.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2"
  }
}
