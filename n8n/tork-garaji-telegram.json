      "id": "72b774e9-e58b-4ccc-9067-d6b598f3b716",
      "name": "GitHub: son işler",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1360,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Son GitHub işlerini okunur bir listeye çevirir\nconst r = $input.first().json;\nif (!(r.statusCode >= 200 && r.statusCode < 300)) return [{ json: { text: '❌ Durumu alamadım (hata ' + r.statusCode + ').' } }];\nconst runs = (r.body && r.body.workflow_runs) || [];\nconst icon = x => x.status !== 'completed' ? '⏳' : x.conclusion === 'success' ? '✅' : x.conclusion === 'cancelled' ? '⚪' : '❌';\nconst when = s => new Date(s).toLocaleString('tr-TR', { timeZone: 'Europe/Berlin', day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' });\nconst lines = runs.map(x => icon(x) + ' ' + x.name + ' · ' + when(x.created_at) + '\\n' + x.html_url);\nreturn [{ json: { text: lines.length ? lines.join('\\n\\n') : 'Henüz iş yok.' } }];"
      },
