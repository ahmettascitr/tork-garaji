      "id": "e541cf69-47ec-4d7e-b139-5b61d97bec53",
      "name": "GitHub: iş başlat",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1360,
        120
      ]
    },
    {
      "parameters": {
        "jsCode": "// GitHub'ın cevabını Telegram mesajına çevirir\nconst src = $('Ne yapılacak?').all(0);\nreturn $input.all().map((it, i) => {\n  const sc = it.json.statusCode;\n  const ok = sc >= 200 && sc < 300;\n  let text = ok ? src[i].json.reply : '❌ GitHub\\'a iletemedim (hata ' + sc + ').';\n  if (sc === 404) text += '\\nDepo adı ya da iş akışı bulunamadı. Ayarlar\\'daki GITHUB_REPO doğru mu, dosyalar GitHub\\'a yüklendi mi?';\n  if (sc === 401 || sc === 403) text += '\\nGitHub anahtarı geçersiz ya da \"Actions: Read and write\" yetkisi yok.';\n  if (sc === 422) text += '\\nİş akışı bu girdiyi kabul etmedi.';\n  return { json: { text } };\n});"
      },
